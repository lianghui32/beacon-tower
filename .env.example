# 密钥样例：复制为 .env 并替换真实值（.env 不入库）
# cp .env.example .env

# Django 签名密钥（生成：python -c "import secrets;print(secrets.token_urlsafe(64))"）
DJANGO_SECRET_KEY=change-me

# 接入令牌（Agent / 日志 / 指标 / RUM 上报用；生成：python -c "import secrets;print(secrets.token_urlsafe(32))"）
OBS_INGEST_TOKEN=change-me

# PostgreSQL 密码
OBS_PG_PASSWORD=change-me

# 对外服务的主机名（逗号分隔；反代域名也加进来）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# web 容器在宿主机上监听的地址：默认只绑 127.0.0.1（反代在本机转发）；
# 要让公网直连 8014 才改成 0.0.0.0，并自行确保防火墙与 HTTPS
OBS_PUBLISH_ADDR=127.0.0.1

# 后台任务租约时长（秒，默认 60）：多副本 worker 时持有者宕机后的最长接管延迟
# OBS_LEASE_TTL_SEC=60

# collectstatic 输出目录：代码树对服务用户只读的部署（systemd + root 拥有的仓库目录）
# 必须指到可写位置，并让 nginx 从同一位置伺服 /static/
# OBS_STATIC_ROOT=/var/lib/beacon/static

# 登录页是否公开展示只读演示账号密码（默认跟随 DEBUG；对外演示时才开）
# OBS_SHOW_DEMO_ACCOUNT=1

# 不用 Compose（systemd 直跑）时直接给数据库串；两者都不设则退回 SQLite(WAL)
# OBS_DATABASE_URL=postgres://obs:pass@127.0.0.1:5432/obs

# 接入令牌 / 演示凭据 / SQLite 兜底库的落盘目录：代码树对服务用户只读时指到可写目录
# OBS_DATA_DIR=/var/lib/beacon

# 走反向代理（HTTPS）时三项一起开，否则访客 IP 全记成代理地址、HTTPS Cookie 与 CSRF 校验会失败
# OBS_TRUST_XFORWARDED_FOR=1
# DJANGO_SECURE_COOKIES=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://obs.example.com

# 请求指标批量缓冲：攒满 N 条或满 M 秒落一批；OBS_METRIC_BUFFER=0 退回逐条同步写库
# OBS_METRIC_BUFFER=1
# OBS_METRIC_BUFFER_BATCH=200
# OBS_METRIC_BUFFER_FLUSH_SEC=1
# OBS_METRIC_BUFFER_QUEUE_SIZE=20000

# 自愈 command 白名单（可执行文件绝对路径，Unix 冒号 / Windows 分号分隔）；不配置则该类型整体禁用
# OBS_HEAL_CMD_ALLOWLIST=/usr/bin/logger:/usr/bin/df

# 出站拨测 / 回调是否放行环回与私网目标（内网拨测需要；对公网开放的多租户部署建议关掉）
# OBS_ALLOW_LOOPBACK_URL=1
# OBS_ALLOW_PRIVATE_URL=1
